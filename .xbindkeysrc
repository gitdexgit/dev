# classic simple
# "flameshot gui"
# Print

# Capture and restore focus to fix i3/flameshot bug
"WID=$(xdotool getactivewindow); flameshot gui; xdotool windowfocus $WID"
Print


# copies directly to the clipboard. Might use it maybe (by maybe = never lol)
