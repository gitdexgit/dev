# _skippy-xd)
# W45 Mon, 03 at 14:46
# ---START------------------------------------------------------------
# ""skippy-xd""
# --------------------------------------------------------------------

# [[alt tab]]

# DESCRIPTION: Skippy-xd is a simple Alt+tab switcher with a preview. Here is the repo to
#              read more aoout it. https://github.com/felixfung/skippy-xd

# Why?: Because openbox alt+tab sucks. And skippy-xd does exactly what I want

# Solution?: ....

# --------------------------------------------------------------------

# Classic Alt+tab with skippy-xd <-- 100% I want this
# This is good on a floating window but on i3. this is meh
# "skippy-xd --switch --pivot Alt_L --next --config ~/.config/skippy-xd/skippy-xd.rc"
# Alt + Tab

# companion classic
# THis is basically alt+tab but this one gives you preview hehehe so you hold super heheh
# To be honest I removed hte pivot I don't pivot a lot or use it like alt tab.
# I'm on i3 baby the concept of alt tab for me is way way you know differnet.
# "skippy-xd --expose --config ~/.config/skippy-xd/skippy-xd2.rc"
# Mod4 + Tab

# Unusable on i3...
# companion classic, just for compatibility so mod4+shift+tab works in preview all windows on all monitors
# THis is basically alt+shift+tab but this one gives you preview hehehe so you hold super heheh
# "skippy-xd --expose --config ~/.config/skippy-xd/skippy-xd2.rc"
# Mod4 + Shift + Tab

# Show all windows of the current workspace. Similar to rofi windowcd
"WID_skippy=$(xdotool getactivewindow); skippy-xd --expose --wm-status sticky,shaded,maximized_vert,maximized_horz,maximized --config ~/.config/skippy-xd/skippy-xd.rc; xdotool windowfocus $WID_skippy"
mod4+comma

# Show windows of the same class of the current workspace. Basically rofi windowcd but only for current class of windows
"WID_skippy=$(xdotool getactivewindow); skippy-xd --expose --desktop -1 --wm-status sticky,shaded,maximized_vert,maximized_horz,maximized --wm-class $(xdotool getwindowclassname $(xdotool getactivewindow)) --config ~/.config/skippy-xd/skippy-xd.rc; xdotool windowfocus $WID_skippy"
mod4+slash

# Unusable on i3...
# "WID_skippy=$(xdotool getactivewindow); skippy-xd --expose --config ~/.config/skippy-xd/skippy-xd.rc; xdotool windowfocus $WID_skippy"
# mod4+control+alt+comma
# Classic show only preview of current active window on current desktop. Very useful for terminals
# This is also used with capslock+super and capslock+/
# "WID_skippy=$(xdotool getactivewindow); skippy-xd --expose --wm-status sticky,shaded,maximized_vert,maximized_horz,maximized --wm-class $(xdotool getwindowclassname $(xdotool getactivewindow)) --config ~/.config/skippy-xd/skippy-xd.rc; xdotool windowfocus $WID_skippy"
# mod4+period

"skippy-xd --expose --wm-class $(xdotool getwindowclassname $(xdotool getactivewindow))"
mod4+control+alt+period

"skippy-xd --expose --desktop -1 --wm-class $(xdotool getwindowclassname $(xdotool getactivewindow)) --config ~/.config/skippy-xd/skippy-xd.rc"
mod4+period
# mod4+control+alt+slash

# Same of mod4+period.
"skippy-xd --expose --desktop -1 --wm-class $(xdotool getwindowclassname $(xdotool getactivewindow)) --config ~/.config/skippy-xd/skippy-xd.rc"
mod4+control+alt+slash

# better than hitting calculator key
"skippy-xd --paging --config ~/.config/skippy-xd/skippy-xd2.rc"
alt+F1

# --------------------------------------------------------------------
# ""skippy-xd""
# ---END--------------------------------------------------------------


