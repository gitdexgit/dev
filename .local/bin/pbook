#!/bin/bash
# pick-book-to-read

BOOK_DIR="$HOME/Documents/books"

# Select file with color preview
FILE=$(find "$BOOK_DIR" -type f | fzf \
    --ansi \
    --prompt="Select Book: " \
    --preview '
        case {} in
            *.pdf) pdftotext -layout -l 10 -q {} - | bat --color=always --style=plain -l md ;;
            *.epub) pandoc -t plain {} | head -n 100 | bat --color=always --style=plain -l md ;;
            *) file {} ;;
        esac')

[ -z "$FILE" ] && exit 0

# Select opener
TOOL=$(printf "zathura\nevince" | fzf --prompt="Open with: ")
[ -z "$TOOL" ] && exit 0

# Execute
"$TOOL" "$FILE" >/dev/null 2>&1 &
