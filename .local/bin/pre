#!/bin/bash

# 1. Get workspace name and extract timestamp
WS_NAME=$(i3-msg -t get_workspaces | jq -r '.[] | select(.num == 10) | .name')
START_TIME_STR=$(echo "$WS_NAME" | awk '{print $NF}')

# 2. Validate format
[[ ! "$START_TIME_STR" =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] && { echo "Error: No valid timestamp."; exit 1; }

# 3. Calculate elapsed time
START_TS=$(date -d "$START_TIME_STR" +%s)
NOW_TS=$(date +%s)
ELAPSED=$(( NOW_TS - START_TS ))
(( ELAPSED < 0 )) && ELAPSED=$(( ELAPSED + 86400 ))

# 4. Generate message
MSG=$(awk -v e="$ELAPSED" -v t="3600" 'BEGIN {
    p = (e / t) * 100;
    if (p > 100) printf "Time up! %.1f%% passed", p
    else printf "Progress: %.1f%% passed | %.1f%% left", p, 100-p
}')

# 5. Output to terminal
echo "$MSG"

# 6. Fast notification (replaces previous notification to avoid lag/clutter)
dunstify -t 1000 "Timer" "$MSG" &
