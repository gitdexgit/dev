#!/bin/bash
# --- CONFIGURATION ---
TIMER_MINUTES=60
TOTAL_SECONDS=$(( TIMER_MINUTES * 60 ))

# 1. Get workspace 10 name (e.g., 10:15:49:53)
WS_NAME=$(i3-msg -t get_workspaces | jq -r '.[] | select(.num == 10) | .name')

# 2. Extract HH:MM:SS
START_TIME_STR=$(echo "$WS_NAME" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}$')

# 3. Validate
if [ -z "$START_TIME_STR" ]; then
    dunstify -u critical "Timer Error" "No HH:MM:SS found in: $WS_NAME"
    exit 1
fi

# 4. Calculate elapsed time
START_TS=$(date -d "$START_TIME_STR" +%s)
NOW_TS=$(date +%s)
ELAPSED=$(( NOW_TS - START_TS ))
(( ELAPSED < 0 )) && ELAPSED=$(( ELAPSED + 86400 ))

# 5. Generate colored pango message
MSG=$(awk -v e="$ELAPSED" -v t="$TOTAL_SECONDS" '
function fmt(s) {
    h = int(s / 3600);
    m = int((s % 3600) / 60);
    if (h == 0) return sprintf("%dm", m);
    return sprintf("%dh %02dm", h, m);
}
BEGIN {
    p_passed = (e / t) * 100;

    pcol = "#50fa7b";
    if (p_passed >= 100) pcol = "#ff5555";
    else if (p_passed >= 75) pcol = "#ff5555";
    else if (p_passed >= 50) pcol = "#f1fa8c";

    if (e >= t) {
        over_sec = e - t;
        p_over = (over_sec / t) * 100;
        printf "Passed: <span color=\"%s\">%s (%.1f%%)</span>\nExtra: <span color=\"#f1fa8c\">%s (%.1f%%)</span>", pcol, fmt(e), p_passed, fmt(over_sec), p_over
    } else {
        left_sec = t - e;
        p_left = 100 - p_passed;
        printf "Passed: <span color=\"%s\">%s (%.1f%%)</span>\nLeft: <span color=\"#8be9fd\">%s (%.1f%%)</span>", pcol, fmt(e), p_passed, fmt(left_sec), p_left
    }
}')

# 6. Urgency
if (( ELAPSED >= TOTAL_SECONDS )); then
    URGENCY="critical"
else
    URGENCY="normal"
fi

dunstify -t 5000 -r 9991 -u "$URGENCY" "Timer Status" "$MSG"
echo "$MSG"
