#!/bin/bash

# Save the desktop we were on before switching windows.
LAST_DESKTOP_FILE="$HOME/.cache/last_desktop"
ORIGINAL_DESKTOP=$(xdotool get_desktop)

# Show Rofi's window switcher.
# The list grows with the number of windows, up to 35 rows.
rofi -show window \
    -lines 35 \
    -font "DejaVu Sans Mono 10" \
    -window-format '{w}    {c}    {t}' \
    -theme-str '
        window {
            width: 100%;
            location: south;
            anchor: south;
        }

        listview {
            columns: 1;
            fixed-height: false;
            scrollbar: true;
            lines: 35;
        }
    '

# Give i3 a moment to finish a possible desktop switch.
sleep 0.2

# Check which desktop we ended up on.
CURRENT_DESKTOP=$(xdotool get_desktop)

# If Rofi moved us to another desktop, remember where we came from.
if [ "$ORIGINAL_DESKTOP" -ne "$CURRENT_DESKTOP" ]; then
    echo "$ORIGINAL_DESKTOP" > "$LAST_DESKTOP_FILE"
fi

# Move the mouse to the newly focused window.
xdotool mousemove --window "$(xdotool getactivewindow)" --polar 0 0
