#!/bin/bash

WS_NUM=10

OLD_NAME=$(i3-msg -t get_workspaces | jq -r --argjson n "$WS_NUM" \
    '.[] | select(.num == $n) | .name')

# Workspace 10 doesn't exist (empty + unfocused ones get destroyed by i3).
# Spawn a terminal, move it there, WITHOUT switching your focus.
if [ -z "$OLD_NAME" ]; then

    BEFORE=$(i3-msg -t get_tree | jq '[.. | objects | select(.window != null) | .window]')

    i3-msg "exec --no-startup-id i3-sensible-terminal" > /dev/null

    NEW_ID=""
    for i in {1..20}; do
        sleep 0.1
        AFTER=$(i3-msg -t get_tree | jq '[.. | objects | select(.window != null) | .window]')
        NEW_ID=$(jq -n --argjson a "$AFTER" --argjson b "$BEFORE" '$a - $b | .[0] // empty')
        [ -n "$NEW_ID" ] && break
    done

    [ -z "$NEW_ID" ] && exit 1

    # plain "move to workspace" does NOT follow — focus stays where you are
    i3-msg "[id=\"$NEW_ID\"] move to workspace number $WS_NUM" > /dev/null

    for i in {1..10}; do
        sleep 0.1
        OLD_NAME=$(i3-msg -t get_workspaces | jq -r --argjson n "$WS_NUM" \
            '.[] | select(.num == $n) | .name')
        [ -n "$OLD_NAME" ] && break
    done
fi

[ -z "$OLD_NAME" ] && exit 1

i3-msg "rename workspace \"$OLD_NAME\" to \"$WS_NUM:$(date +%H:%M:%S)\"" > /dev/null

