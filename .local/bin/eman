#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: eman <page>"
    exit 1
fi

# 1. Check if man page exists
if ! man -w "$1" > /dev/null 2>&1; then
    echo "No manual entry for $1"
    exit 1
fi

# 2. Check if the man-server is already running
# We try to run a simple Lisp command 't'. If it fails, the server is down.
if ! emacsclient -s man-server -e "t" >/dev/null 2>&1; then
    echo "Starting man-pager daemon (silently)..."
    # Start the daemon and send ALL output to /dev/null
    emacs --daemon=man-server >/dev/null 2>&1

    # Wait for the server to actually be ready before continuing
    until emacsclient -s man-server -e "t" >/dev/null 2>&1; do
        sleep 0.1
    done
fi

# 3. Now connect and open the man page
exec emacsclient -s man-server -nw -e "(progn (setq Man-notify-method 'pushy) (man \"$1\"))"
