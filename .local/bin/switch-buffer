#!/bin/bash
Y_OFFSET="60px"
rofi -show windowcd \
    -p "Buffer: " \
    -selected-row 0 \
    -window-format "{t}" \
    -theme-str '
        configuration {
            sidebar-mode: false;
        }
        window {
            location:       north;
            anchor:         north;
            width:          100%;
            y-offset:       '$Y_OFFSET';
            children:       [ mainbox ];
            background-color: #1d2021;
        }
        mainbox {
            orientation:    horizontal;
            children:       [ prompt, entry, listview ];
        }
        prompt {
            padding:        2px 10px;
            background-color: #1d2021;
            text-color:     #fabd2f;
            font:           "Monospace Bold 11";
        }
        entry {
            expand:         false;
            width:          100px;
            padding:        2px 10px;
            text-color:     #ebdbb2;
            background-color: #1d2021;
            placeholder:    "";
        }
        listview {
            layout:         horizontal;
            lines:          100;
            spacing:        0px;
        }
        element {
            padding:        2px 8px;
            border:         0px 1px 0px 0px;
            border-color:   #504945;
            background-color: transparent;
        }
        element-text {
            text-color:     #928374;
            vertical-align: 0.5;
        }
        element selected {
            background-color: transparent;
            border:         0px 1px 0px 0px;
            border-color:   #504945;
        }
        element selected element-text {
            text-color:     #fabd2f;
            font:           "Monospace Bold 11";
        }
    '
