#!/bin/bash

Y_OFFSET="-2px"
MAX_LEN=50
HIST_FILE="/tmp/i3-window-focus-history"

extract_display_name() {
    local name="$1"

    if [[ "$name" == /* ]]; then
        printf '%s' "${name##*/}"
    else
        printf '%s' "$name"
    fi
}

truncate_name() {
    local name="$1"
    local max="$2"
    local len=${#name}

    (( len <= max )) && {
        printf '%s' "$name"
        return
    }

    local keep=$(( (max - 3) / 2 ))

    printf '%s...%s' \
        "${name:0:keep}" \
        "${name: -$keep}"
}

# ------------------------------------------------------------
# Current workspace
# ------------------------------------------------------------

ws_name=$(
    i3-msg -t get_workspaces |
    jq -r '.[] | select(.focused == true) | .name'
)

tree=$(i3-msg -t get_tree)

# ------------------------------------------------------------
# Extract all windows on this workspace
# ------------------------------------------------------------

mapfile -t raw_windows < <(
    echo "$tree" |
    jq -r --arg ws "$ws_name" '
        def find_workspace:
            if .type == "workspace" and .name == $ws then
                .
            else
                ((.nodes // []) + (.floating_nodes // []))
                | map(find_workspace)
                | map(select(. != null))
                | .[0]
            end;

        def leaves:
            if .window != null then
                [ { id: .window, name: .name, focused: .focused } ]
            else
                ((.nodes // []) + (.floating_nodes // []))
                | map(leaves)
                | add // []
            end;

        find_workspace
        | leaves[]
        | "\(.id)\t\(.focused)\t\(.name)"
    '
)

# ------------------------------------------------------------
# Sort by real focus history
# ------------------------------------------------------------

declare -A win_names
declare -A win_focused
declare -A win_exists

for row in "${raw_windows[@]}"; do
    IFS=$'\t' read -r id focused name <<< "$row"
    [ -z "$id" ] && continue
    win_names["$id"]="$name"
    win_focused["$id"]="$focused"
    win_exists["$id"]=1
done

ids=()
titles=()
full_names=()

# 1. Add windows in true MRU order from the history file
if [ -f "$HIST_FILE" ]; then
    while read -r hist_id; do
        [ -z "$hist_id" ] && continue

        # Only include if it belongs to current workspace and is not currently focused
        if [ "${win_exists[$hist_id]}" = "1" ]; then
            if [ "${win_focused[$hist_id]}" != "true" ] && [ -n "${win_names[$hist_id]}" ]; then
                ids+=("$hist_id")
                full_names+=("${win_names[$hist_id]}")
                disp="$(extract_display_name "${win_names[$hist_id]}")"
                titles+=("$(truncate_name "$disp" "$MAX_LEN")")
            fi
            # Unset so we don't duplicate below
            unset 'win_exists[$hist_id]'
        fi
    done < "$HIST_FILE"
fi

# 2. Append any remaining windows that were not yet in history
for row in "${raw_windows[@]}"; do
    IFS=$'\t' read -r id focused name <<< "$row"
    [ -z "$id" ] && continue
    [ "$focused" = "true" ] && continue
    [ -z "$name" ] && continue

    if [ "${win_exists[$id]}" = "1" ]; then
        ids+=("$id")
        full_names+=("$name")
        disp="$(extract_display_name "$name")"
        titles+=("$(truncate_name "$disp" "$MAX_LEN")")
    fi
done

[ "${#titles[@]}" -eq 0 ] && exit 0

# ------------------------------------------------------------
# Rofi
# ------------------------------------------------------------

selected_idx=$(
    for i in "${!titles[@]}"; do
        printf '%s\0meta\x1f%s\n' \
            "${titles[$i]}" \
            "${full_names[$i]}"
    done |
    rofi -dmenu \
        -bw 0 \
        -i \
        -p "Buffer: " \
        -format i \
        -selected-row 0 \
        -theme-str "

            * {
                border: 0px;
                border-color: transparent;
            }

            configuration {
                sidebar-mode: false;
            }

            window {
                location: north;
                anchor: north;
                width: 100%;
                y-offset: ${Y_OFFSET};
                border: 0px;
                border-color: transparent;
                padding: 0px;
                margin: 0px;
                children: [ mainbox ];
                background-color: #222222;
            }

            mainbox {
                orientation: horizontal;
                border: 0px;
                padding: 0px;
                margin: 0px;
                children: [
                    prompt,
                    entry,
                    listview
                ];
                background-color: #222222;
            }

            prompt {
                padding: 2px 10px;
                background-color: #222222;
                text-color: #285577;
                font: \"Monospace Bold 11\";
            }

            entry {
                expand: false;
                width: 100px;
                padding: 2px 10px;
                background-color: #222222;
                text-color: #ffffff;
                placeholder: \"\";
                cursor-color: #ffffff;
            }

            listview {
                layout: horizontal;
                lines: 100;
                spacing: 0px;
                background-color: #222222;
                scrollbar: false;
            }

            element {
                padding: 3px 10px;
                border: 0px 1px 0px 0px;
                border-color: #3a3a3a;
                background-color: #222222;
                text-color: #ffffff;
            }

            element normal.normal {
                background-color: #222222;
                text-color: #ffffff;
                border: 0px 1px 0px 0px;
                border-color: #3a3a3a;
            }

            element-text {
                background-color: transparent;
                text-color: inherit;
                vertical-align: 0.5;
                font: \"Monospace 11\";
            }

            element selected.normal {
                background-color: #285577;
                text-color: #ffffff;
                border: 0px 1px 0px 0px;
                border-color: #3a3a3a;
            }

            element selected.normal element-text {
                background-color: transparent;
                text-color: #ffffff;
                font: \"Monospace Bold 11\";
            }

            element alternate.normal {
                background-color: #222222;
                text-color: #ffffff;
                border: 0px 1px 0px 0px;
                border-color: #3a3a3a;
            }

            element alternate.normal element-text {
                background-color: transparent;
                text-color: #ffffff;
            }
        "
)

[ -z "$selected_idx" ] && exit 0

win_id="${ids[$selected_idx]}"
i3-msg "[id=$win_id] focus"
