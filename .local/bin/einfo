#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: einfo <node>"
    exit 1
fi

# 1. Check if info page exists
if ! info "$1" --where > /dev/null 2>&1; then
    echo "No info entry for $1"
    exit 1
fi

# 2. Ensure daemon is running
if ! emacsclient -s info-server -e "t" >/dev/null 2>&1; then
    emacs --daemon=info-server >/dev/null 2>&1
    until emacsclient -s info-server -e "t" >/dev/null 2>&1; do
        sleep 0.1
    done
fi

# 3. Open info node
exec emacsclient -nw -c -e "(info \"$1\")"
