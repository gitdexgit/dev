#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: einfo <manual> [index-term]"
    exit 1
fi

manual="$1"
shift
term="$*"

if ! info "$manual" --where >/dev/null 2>&1; then
    echo "No info entry for $manual"
    exit 1
fi

if ! emacsclient -s info-server -e "t" >/dev/null 2>&1; then
    emacs --daemon=info-server >/dev/null 2>&1
    until emacsclient -s info-server -e "t" >/dev/null 2>&1; do
        sleep 0.1
    done
fi

if [ -n "$term" ]; then
    elisp=$(printf '(progn (info "%s") (Info-index "%s"))' \
        "$manual" "$term")
else
    elisp=$(printf '(info "%s")' "$manual")
fi

exec emacsclient -nw -s info-server -e "$elisp"

