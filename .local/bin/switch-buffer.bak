#!/bin/bash

Y_OFFSET="-2px"
MAX_LEN=50
HIST_FILE="/tmp/i3-window-focus-history"
ACCENT="#6c9bc2"

extract_display_name() {
    local name="$1"

    if [[ "$name" == /* ]]; then
        printf '%s' "${name##*/}"
    else
        printf '%s' "$name"
    fi
}

truncate_name() {
    local name="$1"
    local max="$2"
    local len=${#name}

    (( len <= max )) && {
        printf '%s' "$name"
        return
    }

    local keep=$(( (max - 3) / 2 ))

    printf '%s...%s' \
        "${name:0:keep}" \
        "${name: -$keep}"
}

# ------------------------------------------------------------
# Current workspace
# ------------------------------------------------------------

ws_name=$(
    i3-msg -t get_workspaces |
    jq -r '.[] | select(.focused == true) | .name'
)

tree=$(i3-msg -t get_tree)

# ------------------------------------------------------------
# Extract all windows on this workspace
# ------------------------------------------------------------

mapfile -t raw_windows < <(
    echo "$tree" |
    jq -r --arg ws "$ws_name" '
        def find_workspace:
            if .type == "workspace" and .name == $ws then
                .
            else
                ((.nodes // []) + (.floating_nodes // []))
                | map(find_workspace)
                | map(select(. != null))
                | .[0]
            end;

        def leaves:
            if .window != null then
                [ { id: .window, name: .name, focused: .focused } ]
            else
                ((.nodes // []) + (.floating_nodes // []))
                | map(leaves)
                | add // []
            end;

        find_workspace
        | leaves[]
        | "\(.id)\t\(.focused)\t\(.name)"
    '
)

# ------------------------------------------------------------
# Sort by real focus history
# ------------------------------------------------------------

declare -A win_names
declare -A win_focused
declare -A win_exists

for row in "${raw_windows[@]}"; do
    IFS=$'\t' read -r id focused name <<< "$row"
    [ -z "$id" ] && continue
    win_names["$id"]="$name"
    win_focused["$id"]="$focused"
    win_exists["$id"]=1
done

ids=()
titles=()
full_names=()

# 1. Add windows in true MRU order from the history file
if [ -f "$HIST_FILE" ]; then
    while read -r hist_id; do
        [ -z "$hist_id" ] && continue

        if [ "${win_exists[$hist_id]}" = "1" ]; then
            if [ "${win_focused[$hist_id]}" != "true" ] && [ -n "${win_names[$hist_id]}" ]; then
                ids+=("$hist_id")
                full_names+=("${win_names[$hist_id]}")
                disp="$(extract_display_name "${win_names[$hist_id]}")"
                titles+=("$(truncate_name "$disp" "$MAX_LEN")")
            fi
            unset 'win_exists[$hist_id]'
        fi
    done < "$HIST_FILE"
fi

# 2. Append any remaining windows that were not yet in history
for row in "${raw_windows[@]}"; do
    IFS=$'\t' read -r id focused name <<< "$row"
    [ -z "$id" ] && continue
    [ "$focused" = "true" ] && continue
    [ -z "$name" ] && continue

    if [ "${win_exists[$id]}" = "1" ]; then
        ids+=("$id")
        full_names+=("$name")
        disp="$(extract_display_name "$name")"
        titles+=("$(truncate_name "$disp" "$MAX_LEN")")
    fi
done

[ "${#titles[@]}" -eq 0 ] && exit 0

# ------------------------------------------------------------
# Rofi
# ------------------------------------------------------------

selected_idx=$(
    for i in "${!titles[@]}"; do
        printf '%s\0meta\x1f%s\n' \
            "${titles[$i]}" \
            "${full_names[$i]}"
    done |
    rofi -dmenu \
        -bw 0 \
        -i \
        -format i \
        -selected-row 0 \
        -kb-row-right "Control+s,Control+Page_Down" \
        -kb-row-left "Control+r,Control+Page_Up" \
        -theme-str "
            * {
                font: \"Monospace 14\";
                border: 0px;
                background-color: transparent;
            }

            configuration {
                sidebar-mode: false;
            }

            window {
                location: north;
                anchor: north;
                width: 100%;
                y-offset: ${Y_OFFSET};
                border: 0px;
                padding: 3px 0px;
                margin: 0px;
                background-color: #1a1a1a;
                children: [ mainbox ];
            }

            mainbox {
                orientation: horizontal;
                spacing: 0px;
                children: [ inputbar, listview, textbox-suffix ];
            }

            inputbar {
                expand: false;
                orientation: horizontal;
                spacing: 0px;
                padding: 0px 0px 0px 10px;
                children: [ entry, textbox-prefix ];
            }

            entry {
                expand: false;
                vertical-align: 0.5;
                placeholder: \"\";
                text-color: #ffffff;
                cursor-width: 2px;
                cursor-color: ${ACCENT};
                font: \"Monospace 14\";
            }

            textbox-prefix {
                expand: false;
                str: \"{\";
                content: \"{\";
                vertical-align: 0.5;
                background-color: transparent;
                text-color: #888888;
                padding: 0px 4px 0px 0px;
                font: \"Monospace 14\";
            }

            listview {
                expand: true;
                layout: horizontal;
                lines: 100;
                spacing: 0px;
                scrollbar: false;
                fixed-height: true;
            }

            element {
                orientation: horizontal;
                children: [ element-text, textbox-sep ];
                padding: 0px;
                margin: 0px;
                background-color: transparent;
            }

            element-text {
                vertical-align: 0.5;
                background-color: transparent;
                text-color: inherit;
                font: inherit;
            }

            textbox-sep {
                expand: false;
                str: \" | \";
                content: \" | \";
                vertical-align: 0.5;
                text-color: #666666;
                font: \"Monospace 14\";
            }

            element normal.normal {
                text-color: #dcdcdc;
                background-color: transparent;
            }

            element alternate.normal {
                text-color: #dcdcdc;
                background-color: transparent;
            }

            element selected.normal {
                text-color: ${ACCENT};
                background-color: transparent;
            }

            element selected.normal element-text {
                text-color: ${ACCENT};
                font: \"Monospace Bold 14\";
            }

            element selected.normal textbox-sep {
                text-color: #666666;
            }

            textbox-suffix {
                expand: false;
                str: \"}\";
                content: \"}\";
                vertical-align: 0.5;
                padding: 0px 10px 0px 0px;
                text-color: #888888;
                font: \"Monospace 14\";
            }
        "
)

[ -z "$selected_idx" ] && exit 0

win_id="${ids[$selected_idx]}"
i3-msg "[id=$win_id] focus"
