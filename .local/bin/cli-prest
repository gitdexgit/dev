#!/bin/bash

# ============================================================
# CLI VISUAL TIMER
# ============================================================

TIMER_MINUTES=60
TOTAL_SECONDS=$((TIMER_MINUTES * 60))

BAR_WIDTH=40


# ============================================================
# COLORS
# ============================================================

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
DIM='\033[2m'
RESET='\033[0m'


# ============================================================
# GET START TIME FROM WORKSPACE 10
# ============================================================

WS_NAME=$(i3-msg -t get_workspaces |
    jq -r '.[] | select(.num == 10) | .name')

START_TIME_STR=$(echo "$WS_NAME" |
    grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}$')


# ============================================================
# VALIDATE
# ============================================================

if [ -z "$START_TIME_STR" ]; then
    echo -e "${RED}Error:${RESET} No timestamp found in workspace 10."
    echo -e "${DIM}Workspace name: $WS_NAME${RESET}"
    exit 1
fi


# ============================================================
# CALCULATE TIME
# ============================================================

START_TS=$(date -d "$START_TIME_STR" +%s)
NOW_TS=$(date +%s)

ELAPSED=$((NOW_TS - START_TS))

# Handle midnight
if (( ELAPSED < 0 )); then
    ELAPSED=$((ELAPSED + 86400))
fi


# ============================================================
# DRAW TIMER
# ============================================================

awk \
    -v e="$ELAPSED" \
    -v t="$TOTAL_SECONDS" \
    -v width="$BAR_WIDTH" \
    -v start="$START_TIME_STR" \
    -v green="$GREEN" \
    -v yellow="$YELLOW" \
    -v red="$RED" \
    -v cyan="$CYAN" \
    -v white="$WHITE" \
    -v dim="$DIM" \
    -v reset="$RESET" '

function fmt(s) {
    h = int(s / 3600)
    m = int((s % 3600) / 60)
    sec = int(s % 60)

    if (h > 0)
        return sprintf("%dh %02dm %02ds", h, m, sec)

    return sprintf("%dm %02ds", m, sec)
}


function make_bar(percent,    filled, empty, result, i) {

    if (percent < 0)
        percent = 0

    if (percent > 100)
        percent = 100

    filled = int((percent / 100) * width + 0.5)
    empty = width - filled

    result = ""

    for (i = 1; i <= filled; i++)
        result = result "█"

    for (i = 1; i <= empty; i++)
        result = result "░"

    return result
}


BEGIN {

    # ========================================================
    # NORMAL TIMER
    # ========================================================

    if (e < t) {

        passed = (e / t) * 100
        remaining = 100 - passed


        # ----------------------------------------------------
        # Passed color
        # ----------------------------------------------------

        if (passed >= 75)
            passed_color = red
        else if (passed >= 50)
            passed_color = yellow
        else
            passed_color = green


        # ----------------------------------------------------
        # Passed bar
        # ----------------------------------------------------

        printf "  %s%5.1f%%%s  %s%s%s  %s\n", \
            passed_color, passed, reset, \
            passed_color, make_bar(passed), reset, \
            fmt(e)


        # ----------------------------------------------------
        # Remaining bar
        # ----------------------------------------------------

        printf "  %s%5.1f%%%s  %s%s%s  %s\n", \
            cyan, remaining, reset, \
            cyan, make_bar(remaining), reset, \
            fmt(t - e)
    }


    # ========================================================
    # OVERTIME
    # ========================================================

    else {

        # Number of completed timer periods
        completed = int(e / t)

        # Seconds into current overtime period
        current = e % t


        # ----------------------------------------------------
        # Completed bars
        # ----------------------------------------------------

        for (i = 0; i < completed; i++) {

            printf "  %s100.0%%%s  %s%s%s  %s\n", \
                red, reset, \
                red, make_bar(100), reset, \
                fmt(t)
        }


        # ----------------------------------------------------
        # Current overtime bar
        # ----------------------------------------------------

        if (current > 0) {

            current_pct = (current / t) * 100

            if (current_pct >= 75)
                overtime_color = red
            else
                overtime_color = yellow

            printf "  %s%5.1f%%%s  %s%s%s  +%s\n", \
                overtime_color, current_pct, reset, \
                overtime_color, make_bar(current_pct), reset, \
                fmt(current)
        }
    }


    # ========================================================
    # START TIME
    # ========================================================

    printf "\n"
    printf "  %sStarted: %s%s\n", dim, start, reset
    printf "\n"
}
'

