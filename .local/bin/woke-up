#!/usr/bin/env bash
WOKEUP_FILE="$HOME/.woke-up"

answer=$1
# Skip prompt only if argument is 'n'
[[ "$answer" != "n" ]] && read -rp "Just woke up? [y/n]: " answer

case "$answer" in
  y|Y)
    date '+%Y-%m-%d %H:%M:%S' > "$WOKEUP_FILE"
    echo "Recorded: $(cat "$WOKEUP_FILE")"
    ;;
  n|N)
    [[ ! -f "$WOKEUP_FILE" ]] && echo "No record." && exit 1

    # GNU date (Linux). For macOS use: date -j -f "%Y-%m-%d %H:%M:%S" "$(cat "$WOKEUP_FILE")" +%s
    wake_epoch=$(date -d "$(cat "$WOKEUP_FILE")" +%s)
    now_epoch=$(date +%s)
    diff=$(( now_epoch - wake_epoch ))

    echo "Awake: $(( diff / 3600 ))h $(( (diff % 3600) / 60 ))m"
    ;;
  *)
    exit 1
    ;;
esac
