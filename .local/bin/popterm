#!/bin/bash
H="$HOME/.popterm_history"
touch "$H"

out=$(tac "$H" | awk '!s[$0]++' | fzf \
    --print-query --query="a " --no-sort --exact \
    --layout=reverse --height=100% --no-info --no-separator \
    --prompt="> " --bind='esc:abort,tab:replace-query,right:replace-query') || [[ -n $out ]] || exit 0

cmd=$(printf '%s\n' "$out" | tail -n1)
[[ -z $cmd ]] && exit 0

printf '%s\n' "$cmd" >> "$H"
setsid -f sh -c "$cmd" >/dev/null 2>&1
