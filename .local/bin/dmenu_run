#!/bin/sh
export PATH="$HOME/.local/bin:$PATH"
CACHE="$HOME/.cache/last_dmenu_cmd"

cmd=$(dmenu_path | dmenu "$@")

[ -z "$cmd" ] && exit 0

# Do NOT save if the command is 'rr' or 'repeat'
case "$cmd" in
    rr|repeat) ;;
    *)
        mkdir -p "$HOME/.cache"
        echo "$cmd" > "$CACHE"
        ;;
esac

/bin/sh -c "$cmd" &
