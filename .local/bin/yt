#!/bin/bash
URL="$1"

# Prompt if no argument
[ -z "$URL" ] && read -r -p "URL: " URL
[ -z "$URL" ] && exit 1

# Get resolutions, sort unique, pick with fzf
RES=$(yt-dlp --list-formats "$URL" | grep -oP '\d{3,4}p' | sort -unr | fzf --header="Select Resolution")

# Strip 'p' for logic
HEIGHT=${RES%p}

# Play. hwdec=auto uses GPU. cache=yes prevents stutter.
[ -n "$HEIGHT" ] && mpv \
    --hwdec=auto \
    --cache=yes \
    --demuxer-max-bytes=500M \
    --ytdl-format="bestvideo[height<=$HEIGHT]+bestaudio/best" \
    "$URL"
