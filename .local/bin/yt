#!/bin/bash
URL="$1"
[ -z "$URL" ] && read -r -p "URL: " URL
[ -z "$URL" ] && exit 1

CHOICE=$(printf '1080p\n720p\n480p\n360p\n240p\naudio-only' | fzf --header="Quality")

[ -z "$CHOICE" ] && exit 0

if [ "$CHOICE" = "audio-only" ]; then
    mpv --vo=null --ytdl-format="bestaudio" --cache=yes "$URL"
else
    HEIGHT=${CHOICE%p}
    mpv \
        --hwdec=auto \
        --cache=yes \
        --demuxer-max-bytes=500M \
        --ytdl-format="bestvideo[height<=$HEIGHT]+bestaudio/best[height<=$HEIGHT]" \
        "$URL"
fi
