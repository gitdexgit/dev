#!/usr/bin/env bash
item="$1"
item="${item#[\'\"]}"
item="${item%[\'\"]}"

case "$item" in
"[TMUX] "*)
  session="${item#\[TMUX\] }"

  active=$(tmux display-message -t "$session:" -p '#{pane_index}' 2>/dev/null)
  pane_list=$(tmux list-panes -t "$session:" -F '#{pane_index}' 2>/dev/null)
  total=$(echo "$pane_list" | wc -l | tr -d ' ')
  pos=$(echo "$pane_list" | awk -v a="$active" '{if($0==a) print NR}')

  windows=$(tmux list-windows -t "$session:" \
    -F "#{window_index}:#{window_name}#{?window_active,*,}" 2>/dev/null | tr '\n' ' ')

  printf '\033[1;34m%s\033[0m  \033[1;33m[%s/%s]\033[0m\n' "$windows" "$pos" "$total"
  echo "------------------------------------"
  off_file="/tmp/tmux-pick-${FZF_PORT:-x}.off"
  h=$(( ${FZF_PREVIEW_LINES:-40} - 2 ))
  content=$(tmux capture-pane -ep -t "$session:" 2>/dev/null)
  total=$(printf '%s\n' "$content" | wc -l)
  max=$(( total - h )); (( max < 0 )) && max=0
  off=$(cat "$off_file" 2>/dev/null || echo 0)
  (( off > max )) && off=$max
  echo "$off" > "$off_file"
  printf '%s\n' "$content" | sed -n "$((off + 1)),$((off + h))p"
  # tmux capture-pane -ep -t "$session:" 2>/dev/null
  ;;
*)
  if [ -d "$item" ]; then
    ls -lA -b --color=always -- "$item" | tr -d '\r\000-\010\013\014\016-\032\034-\037'
  elif [ -f "$item" ]; then
    bat --color=always --style=numbers --line-range=:500 "$item" 2>/dev/null || head -n 100 "$item"
  else
    echo "No preview for: $item"
  fi
  ;;
esac
