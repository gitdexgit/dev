#!/bin/bash

THEME='
* {
    font: "Monospace 12";
    border: 0px;
    border-color: transparent;
}

window {
    width: 100%;
    anchor: north;
    location: north;
    y-offset: -5px;
    border: 0;
    padding: 0;
    margin: 0;
    background-color: #222222;
    children: [ horibox ];
}

horibox {
    orientation: horizontal;
    background-color: #222222;
    children: [ prompt, textbox-prefix, entry, listview, textbox-suffix ];
}

prompt {
    vertical-align: 0.5;
    padding: 0 5px 0 10px;
    background-color: #222222;
    text-color: #285577;
    font: "Monospace Bold 12";
}

textbox-prefix {
    expand: false;
    content: "{";
    vertical-align: 0.5;
    background-color: #222222;
    text-color: #ffffff;
}

entry {
    expand: false;
    width: 35em;
    vertical-align: 0.5;
    placeholder: "";
    background-color: #222222;
    text-color: #ffffff;
    cursor-color: #ffffff;
}

listview {
    layout: horizontal;
    spacing: 0px;
    lines: 100;
    background-color: #222222;
}

element {
    border: 0px 1px 0px 0px;
    border-color: #3a3a3a;
    padding: 2px 8px;
    margin: 0px;
    background-color: #222222;
    text-color: #ffffff;
}

element normal.normal {
    background-color: #222222;
    text-color: #ffffff;
}

element alternate.normal {
    background-color: #222222;
    text-color: #ffffff;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected.normal {
    background-color: #285577;
    text-color: #ffffff;
}

element selected.normal element-text {
    background-color: transparent;
    text-color: #ffffff;
    font: "Monospace Bold 12";
}

textbox-suffix {
    expand: false;
    content: "...}";
    vertical-align: 0.5;
    background-color: #222222;
    text-color: #ffffff;
}
'

rofi -show run \
    -bw 0 \
    -display-run "M-x" \
    -theme-str "$THEME" \
    -run-command "bash -c '{cmd}'" \
    -kb-entry-history-up "Up" \
    -kb-entry-history-down "Down" \
    -kb-row-up "Control+p" \
    -kb-row-down "Control+n" \
    -kb-element-next "" \
    -kb-row-select "Tab"
