#!/usr/bin/env bash
set -euo pipefail

if pactl list modules short 2>/dev/null | grep -qi "echo-cancel"; then
  echo "Echo cancellation is already running."
  exit 0
fi

pactl load-module module-echo-cancel source_name=echocancel_source sink_name=echocancel_sink
pactl set-default-source echocancel_source
pactl set-default-sink echocancel_sink

echo "Echo cancellation enabled and set as default."
