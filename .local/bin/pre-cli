#!/bin/bash

# --- CONFIGURATION ---
TIMER_MINUTES=60
TOTAL_SECONDS=$(( TIMER_MINUTES * 60 ))

# 1. Get workspace 10 name
WS_NAME=$(i3-msg -t get_workspaces | jq -r '.[] | select(.num == 10) | .name')

# 2. Extract HH:MM:SS from end of name
START_TIME_STR=$(echo "$WS_NAME" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}$')

# 3. Validate
if [ -z "$START_TIME_STR" ]; then
    echo -e "\033[1;31mError:\033[0m No timestamp found in workspace 10 name."
    exit 1
fi

# 4. Calculate elapsed time
START_TS=$(date -d "$START_TIME_STR" +%s)
NOW_TS=$(date +%s)
ELAPSED=$(( NOW_TS - START_TS ))
(( ELAPSED < 0 )) && ELAPSED=$(( ELAPSED + 86400 ))

# 5. Generate CLI output
awk -v e="$ELAPSED" -v t="$TOTAL_SECONDS" '
function fmt(s) {
    h = int(s / 3600);
    m = int((s % 3600) / 60);
    return (h > 0 ? h "h " : "") m "m";
}
BEGIN {
    p = (e / t) * 100;
    # Colors: Red (31), Yellow (33), Green (32), Cyan (36)
    c = (p >= 75 ? "\033[1;31m" : (p >= 50 ? "\033[1;33m" : "\033[1;32m"));
    reset = "\033[0m";

    printf "Elapsed: %s%s (%.1f%%)%s\n", c, fmt(e), p, reset;

    if (e >= t) {
        over = e - t;
        printf "Extra:   \033[1;33m%s (%.1f%%)%s\n", fmt(over), (over / t) * 100, reset;
    } else {
        left = t - e;
        printf "Left:    \033[1;36m%s (%.1f%%)%s\n", fmt(left), 100 - p, reset;
    }
}'
