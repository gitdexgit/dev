#!/bin/bash
FILE="$HOME/.cache/last_desktop"
ORIGINAL_DESKTOP=$(xdotool get_desktop)

# 1. Get current focused container ID
ACTIVE_ID=$(i3-msg -t get_tree | jq '.. | select(.focused? == true) | .id')

# 2. Generate list: Filter floating, use .class, keep ID at end
WINDOW_LIST=$(i3-msg -t get_tree | jq -r '
  .. | select(.type? == "workspace") as $ws |
  .. | select(.window? != null) |
  select(
    (
      (.window_properties.title | test("^(btop|main|learn|config|session)$|CopyQ"))
      and (.floating | test("on"))
    ) | not
  ) |
  "\($ws.num | if . == -1 then " " else . end)\t\(.window_properties.class)\t\(.window_properties.title)\t\(.id)"
' | column -t -s $'\t')

# 3. Calculate row index for highlight
ROW_INDEX=$(echo "$WINDOW_LIST" | grep -n "$ACTIVE_ID$" | cut -d: -f1)
[ -n "$ROW_INDEX" ] && SEL_CONF="-selected-row $((ROW_INDEX - 1))" || SEL_CONF=""

# 4. Launch Rofi (Hide column 4, which is the ID)
SELECTION=$(echo "$WINDOW_LIST" | rofi -dmenu -i -p "window" $SEL_CONF -display-columns 1,2,3)
[ -z "$SELECTION" ] && exit

# 5. Switch using the hidden ID (last word of selection)
W_ID=$(echo "$SELECTION" | awk '{print $NF}')
i3-msg "[con_id=$W_ID] focus" > /dev/null

# 6. Post-processing
sleep 0.2
CURRENT_DESKTOP=$(xdotool get_desktop)
[ "$ORIGINAL_DESKTOP" -ne "$CURRENT_DESKTOP" ] && echo "$ORIGINAL_DESKTOP" > "$FILE"
xdotool mousemove --window $(xdotool getactivewindow) --polar 0 0
