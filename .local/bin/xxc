#!/bin/bash
[ -z "$1" ] && exit 1
filepath="$1"
ext=$(echo "${filepath##*.}" | tr '[:upper:]' '[:lower:]')
case "$ext" in
    png) m="image/png" ;;
    jpg|jpeg) m="image/jpeg" ;;
    gif) m="image/gif" ;;
    webp) m="image/webp" ;;
    svg) m="image/svg+xml" ;;
    bmp) m="image/bmp" ;;
    *) m="text/plain" ;;
esac
if [ -n "$WAYLAND_DISPLAY" ]; then
    [ "$m" == "text/plain" ] && wl-copy < "$filepath" || wl-copy -t "$m" < "$filepath"
else
    [ "$m" == "text/plain" ] && xclip -sel c < "$filepath" || xclip -sel c -t "$m" < "$filepath"
fi
