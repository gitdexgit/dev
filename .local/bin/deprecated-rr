#!/bin/sh
export PATH="$HOME/.local/bin:$PATH"
CACHE="$HOME/.cache/last_dmenu_cmd"

slot="${1:-1}"

if [ ! -s "$CACHE" ]; then
    command -v dunstify >/dev/null 2>&1 && dunstify "rr" "Cache is empty" -u critical
    exit 1
fi

cmd1=$(sed -n '1p' "$CACHE")
cmd2=$(sed -n '2p' "$CACHE")

if [ "$slot" = "2" ]; then
    if [ -z "$cmd2" ]; then
        command -v dunstify >/dev/null 2>&1 && dunstify "rr" "Slot 2 is empty" -u critical
        exit 1
    fi
    # Swap: slot 2 moves to top, slot 1 drops to bottom
    printf '%s\n%s\n' "$cmd2" "$cmd1" > "$CACHE"
    exec /bin/sh -c "$cmd2"
fi

exec /bin/sh -c "$cmd1"
