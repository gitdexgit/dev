#!/bin/bash

echo "--- Starting ---"


# IDEA:
# Is to always start clean every time I run this script. But I guess I can do it manually
#
# Define the COMPLETE list of sessions to manage:
# SESSIONS=("999" "config" "session" "btop" "jobs" "sync" "duck")

# Restarting sessions from 0:
# echo "--- Starting Cleanup ---"
# for SESS in "${SESSIONS[@]}"; do
#     if tmux has-session -t "$SESS" 2>/dev/null; then
#         tmux kill-session -t "$SESS"
#     fi
# done

tmux new-session -d -s "main" -c "$HOME" -n "zsh"
tmux new-session -d -s "wiki" -c "$HOME/wiki/" -n "zsh"

tmux new-session -d -s "config"

####
#### .duck
####

tmux new-session -d -s "work" -c "$HOME/work" -n "learn"
tmux send-keys -t "work":1 "nvim aha.md" C-m

tmux new-window -t "work":2 -c "$HOME/work/buffer" -n "~/work/buffer"
tmux send-keys -t "work":2 "ls" C-m

# Fixed typo in path below
tmux new-window -t "work":3 -c "$HOME/work/attachements/" -n "~/work/attachments"

tmux new-window -t "work":4 -c "$HOME/wiki/" -n "~/wiki"

tmux select-window -t "work":1


# TODO:
# I think session should be like this:
# the sessions: https://i.imgur.com/jFl4mYR.png
# window 1: https://i.imgur.com/QqAWvIU.png
# window 2: https://i.imgur.com/QPUMzkI.png
# window 3: https://i.imgur.com/xRJtfpZ.png
# window 4: https://i.imgur.com/TnDak4a.png
