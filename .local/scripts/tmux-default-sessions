####
#### .session
####

SESS="session"
WDIR="/home/dex/work"

SESS="session"
WDIR="/home/dex/work"

# Window 1: session (3 panes)
tmux new-session -d -s "$SESS" -n "session"
tmux split-window -v -t "$SESS":1.1
tmux split-window -h -t "$SESS":1.2

# Use C-m at end to trigger Enter
tmux send-keys -t "$SESS":1.3 "timer" C-m
tmux send-keys -t "$SESS":1.2 '(echo "running" && ssleep 1h && dunstify -u critical -t 0 "Timer" "1 hour passed" && echo "done")' C-m
tmux send-keys -t "$SESS":1.1 'echo -e "\n[Just started tmux-default-sessoins]\n" ; timer' C-m

# Window 2: clock (3 panes - split top, full bottom)
tmux new-window -t "$SESS":2 -n "clock"
tmux split-window -h -t "$SESS":2.1     # Splits 2.1 into 2.1 (top) and 2.2 (bottom)
tmux split-window -v -t "$SESS":2.2     # Splits 2.1 into 2.1 (top-left) and 2.3 (top-right)
tmux send-keys -t "$SESS":2.1 "aclock" C-m
tmux send-keys -t "$SESS":2.2 "acal" C-m
tmux send-keys -t "$SESS":2.3 "ww" C-m



# Window 3: taskwarrior (2 panes)
# tmux new-window -t "$SESS":3 -n "taskwarrior"
# tmux split-window -v -t "$SESS":3.1      # Splits 3.1 into 3.1 (top) and 3.2 (bottom)
# tmux send-keys -t "$SESS":3.1 'watch -n 3 -c "task rc._forcecolor:on"' C-m


# Window 4: timewarrior (3 panes)
# tmux new-window -t "$SESS":4 -n "timewarrior"
# tmux split-window -v -t "$SESS":4      # Splits 4.1 -> 4.1 (top), 4.2 (bottom)
# tmux split-window -h -t "$SESS":4.1    # Splits 4.1 -> 4.1 (top-left), 4.3 (top-right)
# tmux send-keys -t "$SESS":4.1 "watch -n 3 -c timew" C-m
# tmux send-keys -t "$SESS":4.3 "watch -n 3 -c timew summary" C-m

# Window 5: tasks
tmux new-window -t "$SESS":3 -n "tasks and sessions" -c "$WDIR"
tmux send-keys -t "$SESS":3.1 "vim tasks.md sessions.md" C-m



tmux select-window -t "$SESS":1


####
#### .btop
####

tmux new-session -d -s "btop" -n "btop" -c "$HOME"

# Window 1: Absolute minimum sidebars
# Left pane (sensors) = 5 chars
tmux split-window -h -t "btop":1.1 -l 4 -b
# Right pane (ping) = 5 chars
tmux split-window -h -t "btop":1.2 -l 1

# Window 2
tmux new-window -t "btop":2 -c "$HOME" -n "nethogs"

# Window 3
tmux new-window -t "btop":3 -c "$HOME" -n "cpupower"
tmux split-window -h -t "btop":3.1
tmux split-window -v -t "btop":3.1

# Commands
tmux send-keys -t "btop":1.1 "watch -t sensors"
tmux send-keys -t "btop":1.2 "btop" C-m
tmux send-keys -t "btop":1.3 "ping 8.8.8.8" C-m

tmux send-keys -t "btop":2.1 "nethogs" C-m

tmux send-keys -t "btop":3.1 "watch -n 5 cpupower frequency-info" C-m
tmux send-keys -t "btop":3.2 "sudo cpupower frequency-set -u 2800MHz"
tmux send-keys -t "btop":3.3 "sudo cpupower frequency-set -g performance"

tmux select-pane -t "btop":1.2

####
#### .jobs
####

tmux new-session -d -s "jobs" -n "logs"
tmux send-keys -t "jobs:logs" "journalctl -f" C-m

####
#### .sync
####

tmux new-session -d -s "sync" -n "dev" -c "$HOME/dev"
tmux send-keys -t "sync":1 "sleep 1m ; git status" C-m

tmux new-window -t "sync":2 -n "work" -c "$HOME/work"
tmux send-keys -t "sync":2 "sleep 2m ; git status" C-m

tmux new-window -t "sync":3 -n "wiki" -c "$HOME/wiki"
tmux send-keys -t "sync":3 "sleep 3m ; git status" C-m

tmux new-window -t "sync":4 -n "archive_fossil" -c "$HOME/archive_fossil/"
tmux send-keys -t "sync":3 "sleep 3m ; git status" C-m

echo "--- Session Creation Complete ---"
