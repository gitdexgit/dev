

bindsym Mod4+Shift+q kill

bindsym Mod4+j focus left
bindsym Mod4+k focus down
bindsym Mod4+l focus up
bindsym Mod4+semicolon focus right

bindsym Mod4+Shift+j move left
bindsym Mod4+Shift+k move down
bindsym Mod4+Shift+l move up
bindsym Mod4+Shift+semicolon move right

bindsym Mod4+grave workspace back_and_forth

bindsym Mod4+v split v
bindsym Mod4+h split h

bindsym Mod4+f fullscreen toggle

bindsym Mod4+s layout stacking
bindsym Mod4+w layout tabbed
bindsym Mod4+e layout toggle split

bindsym Mod4+Shift+space floating toggle

bindsym Mod4+space       focus mode_toggle

bindsym Mod4+a focus parent
bindsym Mod4+g focus child

bindsym Mod4+Shift+minus move scratchpad
bindsym Mod4+minus scratchpad show

bindsym Mod4+1 workspace number $ws1
bindsym Mod4+2 workspace number $ws2
bindsym Mod4+3 workspace number $ws3
bindsym Mod4+4 workspace number $ws4
bindsym Mod4+5 workspace number $ws5
bindsym Mod4+6 workspace number $ws6
bindsym Mod4+7 workspace number $ws7
bindsym Mod4+8 workspace number $ws8
bindsym Mod4+9 workspace number $ws9
bindsym Mod4+0 workspace number $ws10

bindsym Mod4+Shift+1 move container to workspace number $ws1
bindsym Mod4+Shift+2 move container to workspace number $ws2
bindsym Mod4+Shift+3 move container to workspace number $ws3
bindsym Mod4+Shift+4 move container to workspace number $ws4
bindsym Mod4+Shift+5 move container to workspace number $ws5
bindsym Mod4+Shift+6 move container to workspace number $ws6
bindsym Mod4+Shift+7 move container to workspace number $ws7
bindsym Mod4+Shift+8 move container to workspace number $ws8
bindsym Mod4+Shift+9 move container to workspace number $ws9
bindsym Mod4+Shift+0 move container to workspace number $ws10

bindsym Mod4+Shift+c reload
bindsym Mod4+Shift+r restart
bindsym Mod4+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

bindsym Mod4+Return exec st -t st
bindsym Mod4+d exec dmenu_run
bindsym Mod4+z exec boomer

# switch-last-buffer this tracker has to be there for it to work well
exec_always --no-startup-id ~/.config/i3/scripts/i3-focus-tracker.sh
bindsym Mod4+Tab exec --no-startup-id ~/.local/bin/switch-last-buffer


# Just so handy to see icons because dmenu doesn't have them for programs names
# also search by program name it's handy.
bindsym Mod1+F2 exec --no-startup-id "rofi -show drun -show-icons"

# i3-back
exec --no-startup-id i3-back
bindsym Mod1+Tab        [con_mark=_back] focus

# A program I made that works well with i3-back and it just fast. feels like emacs on i3
bindsym Mod4+b exec --no-startup-id switch-buffer

# This program makes using the mouse less
bindsym Mod4+Shift+f exec --no-startup-id "warpd --hint"

# fast screenshot no bs or drawing... just select region and boom it's in your clipboard.
bindsym Mod1+Control+s exec scrot -s /tmp/s.png && xclip -selection clipboard -t image/png -i /tmp/s.png && rm /tmp/s.png

# a screenshot program on print
bindsym --release Print exec --no-startup-id ~/.local/bin/f-screenshot

# this makes ~/.local/bin/scr-pin look like pin.
for_window [class="pin_shot"] floating enable, border none

# emacs anywhere
bindsym Mod1+Control+e exec ~/.local/bin/e

# My clipboard menu
bindsym Mod4+c exec --no-startup-id clipmenu


# lock computer and turn off screen.
bindsym Control+Mod1+l exec --no-startup-id "i3lock; sleep 0.5; xset dpms force off"

# mic toggle for discord and coms.
bindsym Mod4+m exec --no-startup-id "~/.local/bin/mic-toggle"

# Real handy too lazy to switch to firefox and type url then inside webpage seach the thing. just 1 search take me there man
bindsym Mod4+y exec --no-startup-id quick-search
bindsym Mod4+Shift+y exec --no-startup-id web-search

# So handy for volume up and down and mute... instead of bringing gui pavucontrol or something.
bindsym Mod4+Control+BackSpace exec --no-startup-id ~/.local/bin/volumectl mute
bindsym Mod4+Control+minus exec --no-startup-id ~/.local/bin/volumectl down
bindsym Mod4+Control+equal exec --no-startup-id ~/.local/bin/volumectl up

# pavucontrol with dark theme. also it's faster here than typing it on keyboard.
bindsym Control+Mod4+7 exec --no-startup-id "GTK_THEME=Arc-Dark pavucontrol"

font pango:Iosevka 10

new_window pixel 1
new_float pixel 1

# set it both or none.
hide_edge_borders both

focus_follows_mouse no

# stupid mouse scroll i3 tabs
bindsym button4 nop
bindsym button5 nop

floating_modifier Mod4

tiling_drag modifier titlebar

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

set $ws11 "11"
set $ws12 "12"
set $ws13 "13"
set $ws14 "14"
set $ws15 "15"
set $ws16 "16"
set $ws17 "17"
set $ws18 "18"
set $ws19 "19"
set $ws20 "20"

workspace 1  output HDMI-1
workspace 2  output HDMI-1
workspace 3  output HDMI-1
workspace 4  output HDMI-1
workspace 5  output HDMI-1
workspace 6  output HDMI-1
workspace 7  output HDMI-1
workspace 8  output HDMI-1
workspace 9  output HDMI-1
workspace 10 output HDMI-1

workspace 11 output eDP-1
workspace 12 output eDP-1
workspace 13 output eDP-1
workspace 14 output eDP-1
workspace 15 output eDP-1
workspace 16 output eDP-1
workspace 17 output eDP-1
workspace 18 output eDP-1
workspace 19 output eDP-1
workspace 20 output eDP-1

# Gromit-MPX (screen annotation)
exec --no-startup-id sh -c "sleep 6; gromit-mpx -o 0.5"

# Razer DPI (fix my mouse)
exec --no-startup-id sh -c "sleep 3; razer-cli --dpi 400"

# Fixes
#########
# exec_always --no-startup-id sh -c "setxkbmap us; xmodmap ~/.Xmodmap; xset r rate 220 50"
exec_always --no-startup-id sh -c "setxkbmap us; xset r rate 220 50"
exec --no-startup-id xsetroot -solid "#000000"
exec_always --no-startup-id hsetroot -solid '#000000'


# fixes clipboard manager copying my passwords
exec_always --no-startup-id env CM_IGNORE_WINDOW=".*KeePassXC.*" clipmenud

# I hate the mouse visibile so this fixes it
exec --no-startup-id unclutter --timeout 5 --ignore-scrolling --jitter 10 --fork

# for ctrl+mod4+e
exec --no-startup-id emacs --daemon

# fixes my mic to an extent
exec --no-startup-id noisetorch -i

# picom is better but this is light
exec --no-startup-id xcompmgr -n

# 2nd screenshot program I use. The first one is scrot and like
exec --no-startup-id flameshot

# My notification program.
exec --no-startup-id dunst

# fixes ueberzugpp/Yazi previews inside tmux
exec --no-startup-id ~/scripts/fix/yazi-ueberzugpp-tmux-fix

exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym Mod4+Mod1+equal exec --no-startup-id ~/.local/bin/hdmi-brightness up
bindsym Mod4+Mod1+minus exec --no-startup-id ~/.local/bin/hdmi-brightness down

mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym Mod4+r mode "default"
}

bindsym Mod4+r mode "resize"

bar {
    mode dock
    # mode invisible
    wheel_up_cmd nop
    wheel_down_cmd nop
    status_command i3status
    position bottom
    strip_workspace_numbers yes
    # tray_output HDMI-1
    tray_output primary
    font pango:Iosevka 10
}
