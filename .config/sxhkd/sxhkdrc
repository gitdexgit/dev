# --- Universal Chords (Leader: Alt + Space) ---

# Simple sequences
alt + space ; {b,Left}
    switch-buffer

alt + space ; Tab
    switch-buffer-preview

alt + space ; control + b
    switch-all-visible-buffer

alt + space ; k
    i3-msg kill

alt + space ; s
    quick-search

alt + space ; d
    dmenu_run

alt + space ; shift + s
    web-search

# Nested: x -> r, b, control + b
alt + space ; x ; r
    rename-buffer

alt + space ; x ; b
    switch-buffer-preview-horizontal

alt + space ; x ; control + b
    switch-all-buffer

# Nested: 8 -> e -> s
alt + space ; 8 ; e ; s
    emoji

# Nested: t -> {t,r,m,o,O}
alt + space ; t ; t
    switch-workspace

alt + space ; t ; r
    rename-workspace

alt + space ; t ; m
    move-buffer-to-workspace

alt + space ; t ; o
    xdotool set_desktop --relative -- 1

alt + space ; t ; O
    xdotool set_desktop --relative -- -1

# Nested: 5 -> {o,m}
alt + space ; 5 ; {o,m}
    i3-msg {focus output next,move container to output next}

# Nested: q -> {r,l,q,k,c,z}
alt + space ; q ; {r,l,q,k,c,z}
    {i3-msg restart,i3-msg reload,i3-msg exit,xkill,xcontrol -c,xcontrol -z}

# Move between virtual desktops
alt + space ; h
    xdotool set_desktop --relative -- -1

alt + space ; l
    xdotool set_desktop --relative -- 1
