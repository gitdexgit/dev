# Only use sxhkdrc for the seuqnces for emacs like and that's it do not bind in here

# --- Universal Chords (Leader: C-M-x) ---

# Simple sequences
ctrl + alt + x ; {b,Left}
    switch-buffer

ctrl + alt + x ; control + b
    switch-all-buffer

ctrl + alt + x ; k
    i3-msg kill

ctrl + alt + x ; s
    quick-search

ctrl + alt + x ; shift + s
    web-search

# Nested: x -> r
ctrl + alt + x ; x ; r
    rename-buffer

# --- Universal Chords (Leader: C-M-x) ---
# Nested: 8 -> e -> s
ctrl + alt + x ; 8 ; e ; s
    emoji

# Nested: t -> {t,r,m}
# ctrl + alt + x ; t ; {t,r,m}
#     {switch-workspace,rename-workspace,move-buffer-to-workspace}

# Nested: t -> {t,r,m,o,O}
ctrl + alt + x ; t ; t
     switch-workspace

ctrl + alt + x ; t ; r
     rename-workspace

ctrl + alt + x ; t ; m
     move-buffer-to-workspace

ctrl + alt + x ; t ; o
     xdotool set_desktop --relative -- 1

ctrl + alt + x ; t ; O
     xdotool set_desktop --relative -- -1


# Nested: 5 -> {o,m}
ctrl + alt + x ; 5 ; {o,m}
    i3-msg {focus output next,move container to output next}

# Nested: q -> {r,l,q,k,c,z}
ctrl + alt + x ; q ; {r,l,q,k,c,z}
    {i3-msg restart,i3-msg reload,i3-msg exit,xkill,xcontrol -c,xcontrol -z}

ctrl + alt + x ; x ; b
    switch-buffer-preview-horizontal


# --- Universal Chords (Leader: C-M-x) ---

# Move between virtual desktops
ctrl + alt + x ; h
    xdotool set_desktop --relative -- -1

ctrl + alt + x ; l
    xdotool set_desktop --relative -- 1

