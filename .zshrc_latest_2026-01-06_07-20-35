lsg() {
  if [ -z "$1" ]; then
    # If no argument is given, just do a normal ls -la
    lsd -l --color=always
  else
    # If there is an argument, pipe ls to grep
    # --color=auto highlights the match
    lsd -la --color=always | grep "$1"
  fi
}

