#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
LOCAL_MODEL="qwen2.5-coder:7b"
MAX_RETRIES=3

CLIP=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$CLIP" ] && dunstify -u normal -t 2000 -a "json-type" "⚠ nothing in clipboard" && exit 0

# Ask for target language
LANG=$(echo -e "TypeScript\nGo\nRust\nPython\nC++\nJava" | rofi -dmenu -p "Target Language:" -i)
[ -z "$LANG" ] && exit 0

SYSTEM_PROMPT="Respond terse like smart caveman. All technical substance stay. Only fluff die.
Role: Type Architect.
Goal: Convert JSON to $LANG types/structs.
Rules:
- Use idiomatic naming (camelCase/PascalCase/snake_case).
- Handle nested objects.
- Output ONLY code block."

PROMPT="$SYSTEM_PROMPT

JSON:
$CLIP"

for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST \
    -H "Authorization: Bearer $HF_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"model\": \"$HF_MODEL\",
        \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]
    }")

  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')

  if [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ]; then
    FINAL_TEXT="$CLEAN_RES"
    break
  else
    ERR=$(echo "$RESULT" | jq -r '.error.message // "Unknown error"')
    dunstify -u normal -t 2000 -a "json-type" "HF Fail ($i/$MAX_RETRIES): $ERR"
    sleep 2
  fi
done

if [ -z "$FINAL_TEXT" ]; then
  echo "HF Router failed. Use local?"
  read -p "Use local $LOCAL_MODEL? (y/n): " CHOICE
  if [[ "$CHOICE" =~ ^[Yy]$ ]]; then
    FINAL_TEXT=$(curl -s http://localhost:11434/api/generate \
      -H "Content-Type: application/json" \
      -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0},\"stream\":false}" \
      | jq -r '.response')
  fi
fi

[ -z "$FINAL_TEXT" ] && dunstify -u critical -t 3000 -a "json-type" "✗ All LLMs failed" && exit 1

echo -n "$FINAL_TEXT" | xclip -selection clipboard
dunstify -u low -t 1400 -a "json-type" -h "string:bgcolor:#00897b" -h "string:fgcolor:#ffffff" "✓ $LANG types ready"
