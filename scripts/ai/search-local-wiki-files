#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
LOCAL_MODEL="llama3.2:latest"
WIKI_DIR=~/wiki
MAX_RETRIES=3

QUERY=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$QUERY" ] && dunstify -u normal -t 2000 -a "search-wiki" "⚠ nothing in clipboard" && exit 0

TITLES=$(for f in "$WIKI_DIR"/*.md; do basename "$f"; done)

PROMPT="You are a wiki search assistant.
Article titles:
$TITLES

User query: $QUERY

Return ONLY titles from list that match intent (include .md).
One per line.
No explanations.
If no match, return exactly: no match"

# Try HF Router
for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST \
    -H "Authorization: Bearer $HF_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"model\": \"$HF_MODEL\",
        \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]
    }")

  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')

  if [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ]; then
    FINAL_TEXT="$CLEAN_RES"
    break
  else
    ERR=$(echo "$RESULT" | jq -r '.error.message // "Unknown error"')
    dunstify -u normal -t 2000 -a "search-wiki" "HF Fail ($i/$MAX_RETRIES): $ERR"
    sleep 2
  fi
done

# Fallback
if [ -z "$FINAL_TEXT" ]; then
  echo "HF Router failed after $MAX_RETRIES attempts."
  read -p "Use local Ollama? (y/n): " CHOICE
  if [[ "$CHOICE" =~ ^[Yy]$ ]]; then
    FINAL_TEXT=$(curl -s http://localhost:11434/api/generate \
      -H "Content-Type: application/json" \
      -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0},\"stream\":false}" \
      | jq -r '.response')
  fi
fi

if [ -z "$FINAL_TEXT" ] || [ "$FINAL_TEXT" = "no match" ]; then
    dunstify -u normal -t 2000 -a "search-wiki" -h "string:bgcolor:#e53935" -h "string:fgcolor:#ffffff" "✗ no wiki match found"
    exit 0
fi

echo -n "$FINAL_TEXT" | xclip -selection clipboard
dunstify -u low -t 1400 -a "search-wiki" -h "string:bgcolor:#1e88e5" -h "string:fgcolor:#ffffff" "✓ wiki match ready"
