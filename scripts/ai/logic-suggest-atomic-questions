#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
LOCAL_MODEL="llama3.2:latest"
MAX_RETRIES=3

CLIP=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$CLIP" ] && dunstify -u normal -t 2000 -a "atomq" "⚠ nothing in clipboard" && exit 0

PROMPT="You are an atomic question refiner. Output must be shell-safe for filenames.
Rules:
1. Extract recall target. One target = one question.
2. Domain prefix always: 'In [domain]...'
3. No commas, parentheses, double quotes, or shell chars (? * : < > | \\ / ! \$ &).
4. ASCII only. Single quotes '' OK. Use -> for arrows.
5. Provide 3 alt phrasings so I can pick the best one.

Output format:
[LOGIC]
Recall target: [target]
[/LOGIC]
[ANS]
1. [Primary Question]
   - [Alt phrasing A]
   - [Alt phrasing B]
[/ANS]

Input:
$CLIP"

# Try HF Router
for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST \
    -H "Authorization: Bearer $HF_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"model\": \"$HF_MODEL\",
        \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]
    }")

  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')

  if [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ]; then
    FINAL_TEXT="$CLEAN_RES"
    break
  else
    ERR=$(echo "$RESULT" | jq -r '.error.message // "Unknown error"')
    dunstify -u normal -t 2000 -a "atomq" "HF Fail ($i/$MAX_RETRIES): $ERR"
    sleep 2
  fi
done

# Fallback
if [ -z "$FINAL_TEXT" ]; then
  echo "HF Router failed after $MAX_RETRIES attempts."
  read -p "Use local Ollama? (y/n): " CHOICE
  if [[ "$CHOICE" =~ ^[Yy]$ ]]; then
    FINAL_TEXT=$(curl -s http://localhost:11434/api/generate \
      -H "Content-Type: application/json" \
      -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0},\"stream\":false}" \
      | jq -r '.response')
  fi
fi

[ -z "$FINAL_TEXT" ] && dunstify -u critical -t 3000 -a "atomq" "✗ All LLMs failed" && exit 1

echo -n "$FINAL_TEXT" | xclip -selection clipboard
dunstify -u low -t 1400 -a "atomq" \
  -h "string:bgcolor:#1e88e5" -h "string:fgcolor:#ffffff" "✓ atomq ready"
