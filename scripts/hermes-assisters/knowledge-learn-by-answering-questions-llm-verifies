#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
LOCAL_MODEL="qwen2.5-coder:7b"
MAX_RETRIES=3

CLIP=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$CLIP" ] && dunstify -u normal -t 2000 -a "learn" "⚠ nothing in clipboard" && exit 0

SYSTEM_PROMPT="Q&A learning evaluator. Terse. Passionate teacher. Never spoon-feed.
Rules:
1. Question check: Too broad/vague? Refuse. Tell user split/sharpen. Stop.
2. Concept check:
   - Correct model + wrong term → PASS. Teach term.
   - Correct model + imprecise → PASS.
   - Wrong model → FAIL. Quote wrong phrase. Ask one Socratic question. Stop. Never give answer.
   - Hedging ('maybe') → FAIL. Demand binary stance.
3. Fail priority: Q shape → Answer form → Concept logic → Term precision.

Output Format:
On PASS: ✅ Correct. 📖 How I'd say it: <ultra-compressed ground truth>. 🪬 Sit with: <2 probing questions>.
On PASS (wrong term): ✅ Correct concept. 📌 Term: <user_word> vs <correct_term>. 📖 How I'd say it: <ultra-compressed ground truth>. 🪬 Sit with: <2 probing questions>.
On FAIL: ❌ Reset. Try again. 💡 Good: <partial>. ❌ Logic: '<wrong phrase>' — <why>. 🧭 Think about: <Socratic question>."

PROMPT="$SYSTEM_PROMPT

Input:
$CLIP"

for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST \
    -H "Authorization: Bearer $HF_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"model\": \"$HF_MODEL\",
        \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]
    }")

  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')

  if [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ]; then
    FINAL_TEXT="$CLEAN_RES"
    break
  else
    ERR=$(echo "$RESULT" | jq -r '.error.message // "Unknown error"')
    dunstify -u normal -t 2000 -a "learn" "HF Fail ($i/$MAX_RETRIES): $ERR"
    sleep 2
  fi
done

if [ -z "$FINAL_TEXT" ]; then
  echo "HF Router failed. Use local?"
  read -p "Use local $LOCAL_MODEL? (y/n): " CHOICE
  if [[ "$CHOICE" =~ ^[Yy]$ ]]; then
    FINAL_TEXT=$(curl -s http://localhost:11434/api/generate \
      -H "Content-Type: application/json" \
      -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0},\"stream\":false}" \
      | jq -r '.response')
  fi
fi

[ -z "$FINAL_TEXT" ] && dunstify -u critical -t 3000 -a "learn" "✗ All LLMs failed" && exit 1

echo -n "$FINAL_TEXT" | xclip -selection clipboard
dunstify -u low -t 1400 -a "learn" -h "string:bgcolor:#1e88e5" -h "string:fgcolor:#ffffff" "✓ evaluation ready"
