#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
LOCAL_MODEL="deepseek-r1:8b"
MAX_RETRIES=3

CLIP=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$CLIP" ] && dunstify -u normal -t 2000 -a "duck" "⚠ nothing in clipboard" && exit 0

SYSTEM_PROMPT="Role: Socratic Rubber Duck.
Goal: Help user find answer by asking deep questions.
Rules:
- DO NOT give answer.
- Ask 2-3 questions that target core logic or hidden assumptions.
- Terse. No fluff."

PROMPT="$SYSTEM_PROMPT

Problem:
$CLIP"

for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST \
    -H "Authorization: Bearer $HF_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"model\": \"$HF_MODEL\",
        \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]
    }")

  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')

  if [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ]; then
    FINAL_TEXT="$CLEAN_RES"
    break
  else
    ERR=$(echo "$RESULT" | jq -r '.error.message // "Unknown error"')
    dunstify -u normal -t 2000 -a "duck" "HF Fail ($i/$MAX_RETRIES): $ERR"
    sleep 2
  fi
done

if [ -z "$FINAL_TEXT" ]; then
  echo "HF Router failed. Use local?"
  read -p "Use local $LOCAL_MODEL? (y/n): " CHOICE
  if [[ "$CHOICE" =~ ^[Yy]$ ]]; then
    FINAL_TEXT=$(curl -s http://localhost:11434/api/generate \
      -H "Content-Type: application/json" \
      -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0.6},\"stream\":false}" \
      | jq -r '.response')
  fi
fi

[ -z "$FINAL_TEXT" ] && dunstify -u critical -t 3000 -a "duck" "✗ All LLMs failed" && exit 1

echo -n "$FINAL_TEXT" | xclip -selection clipboard

# why Change last line of duck-socratic
dunstify -u low -t 1400 -a "duck" -h "string:bgcolor:#fbc02d" -h "string:fgcolor:#000000" "✓ duck questions ready"
