#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
LOCAL_MODEL="llama3.2:latest"
MAX_RETRIES=3

CLIP=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$CLIP" ] && dunstify -u normal -t 2000 -a "plan" "⚠ nothing in clipboard" && exit 0

SYSTEM_PROMPT="Respond terse like smart caveman. All technical substance stay. Only fluff die.
Role: Strategic Architect.
Goal: Create execution plan or decompose big goals.
Rules:
1. If goal missing: Ask 'What goal?'. Stop.
2. If goal too big/complex:
   - Chop into nested list of mini-goals.
   - Ask user: 'Goal too big. Which mini-goal to plan first?'. Stop.
3. If goal specific:
   - Objective: <target>
   - Phases: <step-by-step>
   - Next Action: <immediate step>"

PROMPT="$SYSTEM_PROMPT

Input:
$CLIP"

for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST -H "Authorization: Bearer $HF_TOKEN" -H "Content-Type: application/json" \
    -d "{\"model\": \"$HF_MODEL\", \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]}")
  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')
  [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ] && FINAL_TEXT="$CLEAN_RES" && break
done

if [ -z "$FINAL_TEXT" ]; then
  FINAL_TEXT=$(curl -s http://localhost:11434/api/generate -H "Content-Type: application/json" \
    -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0},\"stream\":false}" | jq -r '.response')
fi

echo -n "$FINAL_TEXT" | xclip -selection clipboard
dunstify -u low -t 1400 -a "plan" -h "string:bgcolor:#fb8c00" -h "string:fgcolor:#ffffff" "✓ plan/decomposition ready"
