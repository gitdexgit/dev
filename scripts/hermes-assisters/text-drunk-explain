#!/bin/bash
HF_TOKEN=$(cat ~/.key/HF_TOKEN)
HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
LOCAL_MODEL="hermes3:latest"
MAX_RETRIES=3

CLIP=$(xclip -o -selection clipboard 2>/dev/null)
[ -z "$CLIP" ] && dunstify -u normal -t 2000 -a "drunk" "⚠ nothing in clipboard" && exit 0

SYSTEM_PROMPT="Explain like I'm 5 and you're slightly drunk. Pizza/car analogies. No jargon.
Rules:
- Zero jargon. Explain technical words with pizza or car analogies.
- Enthusiastic. Warm and wobbly.
- Short sentences. Simple words.
- No 'essentially', 'basically', 'in other words'.
Pattern: [pizza/car analogy]. [actual point]. [why it matters, simply].
Auto-Sober: Normal prose for Security/Data/Legal only. One sentence max."

PROMPT="$SYSTEM_PROMPT

Input:
$CLIP"

for i in $(seq 1 $MAX_RETRIES); do
  RESULT=$(curl -s "https://router.huggingface.co/v1/chat/completions" \
    -X POST \
    -H "Authorization: Bearer $HF_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"model\": \"$HF_MODEL\",
        \"messages\": [{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]
    }")

  CLEAN_RES=$(echo "$RESULT" | jq -r '.choices[0].message.content // empty')

  if [ -n "$CLEAN_RES" ] && [ "$CLEAN_RES" != "null" ]; then
    FINAL_TEXT="$CLEAN_RES"
    break
  else
    ERR=$(echo "$RESULT" | jq -r '.error.message // "Unknown error"')
    dunstify -u normal -t 2000 -a "drunk" "HF Fail ($i/$MAX_RETRIES): $ERR"
    sleep 2
  fi
done

if [ -z "$FINAL_TEXT" ]; then
  echo "HF Router failed. Use local?"
  read -p "Use local $LOCAL_MODEL? (y/n): " CHOICE
  if [[ "$CHOICE" =~ ^[Yy]$ ]]; then
    FINAL_TEXT=$(curl -s http://localhost:11434/api/generate \
      -H "Content-Type: application/json" \
      -d "{\"model\":\"$LOCAL_MODEL\",\"prompt\":$(jq -n --arg p "$PROMPT" '$p'),\"options\":{\"temperature\":0.8},\"stream\":false}" \
      | jq -r '.response')
  fi
fi

[ -z "$FINAL_TEXT" ] && dunstify -u critical -t 3000 -a "drunk" "✗ All LLMs failed" && exit 1

echo -n "$FINAL_TEXT" | xclip -selection clipboard
dunstify -u low -t 1400 -a "drunk" -h "string:bgcolor:#ff8a65" -h "string:fgcolor:#ffffff" "🍺 drunk explain ready"
